# MEGA-RAG Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER SETTINGS
# =============================================================================
# Provider: "auto" (recommended), "gemini", "groq", "ollama"
# "auto" tries each provider in the fallback chain until one works.
LLM_PROVIDER=auto

# Fallback order (comma-separated). Tried in order when primary fails.
LLM_FALLBACK_CHAIN=gemini,groq,ollama

# Set to "false" to disable auto-fallback (use only the primary provider)
LLM_AUTO_FALLBACK=true

# =============================================================================
# GEMINI (Google AI Studio) — Free: 1,500 req/day
# Get key: https://aistudio.google.com/apikey
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# GROQ (GroqCloud) — Free: 14,400 req/day, ultra-fast
# Get key: https://console.groq.com/keys
# =============================================================================
GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# Other free models:
#   deepseek-r1-distill-llama-70b  (strong reasoning)
#   llama-3.1-8b-instant           (fastest)
#   gemma2-9b-it                   (good balance)
#   mixtral-8x7b-32768             (32K context)

# =============================================================================
# OLLAMA (Local) — Free, runs on your machine
# Install: https://ollama.ai → ollama pull meditron
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=meditron
# OLLAMA_MAX_TOKENS=512
